# Multi-stage Dockerfile for TrustMesh Backend
FROM node:20-slim AS builder

WORKDIR /app

# Install build essentials if required
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package descriptors
COPY shared/package*.json ./shared/
COPY backend/package*.json ./backend/

# Install dependencies
RUN npm --prefix shared install
RUN npm --prefix backend install

# Copy source files
COPY shared ./shared
COPY backend ./backend

# Build backend bundle with tsup
RUN npm --prefix backend run build

# Production runtime stage
FROM node:20-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Copy production artifacts
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/backend/package*.json ./backend/
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/src/db/schema.sql ./backend/src/db/schema.sql
COPY --from=builder /app/backend/node_modules ./backend/node_modules

# Create persistent storage directories
RUN mkdir -p /app/backend/data /app/backend/keystore

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:4000/api/health || exit 1

WORKDIR /app/backend
CMD ["node", "dist/index.js"]
